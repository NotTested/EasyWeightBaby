generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  role          String   @default("member")
  timeZone      String   @default("Asia/Seoul")
  sessions      Session[]
  accounts      Account[]
  invitations   Invitation[]
  workouts      WorkoutSession[]
  exercises     Exercise[]
  routines      Routine[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Account {
  id                     String   @id
  accountId              String
  providerId             String
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken            String?
  refreshToken           String?
  idToken                String?
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  scope                  String?
  password               String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  @@index([userId])
  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier])
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Invitation {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  email      String?
  expiresAt  DateTime
  usedAt     DateTime?
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  createdBy  String
  creator    User     @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  @@index([createdBy, createdAt])
}

// 초대 가입 API의 전역 부하 제한. 키는 작업과 시간 구간으로 구성합니다.
model RequestBucket {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}

model WorkoutSession {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title     String
  localDate String   @db.VarChar(10)
  timeZone  String   @default("Asia/Seoul")
  status    String   @default("in_progress")
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  startedAt DateTime?
  startKey String?
  startHash String?
  routineVersionId String?
  routineVersion RoutineVersion? @relation(fields: [routineVersionId], references: [id], onDelete: Restrict)
  routineName String?
  routineNumber Int?
  routineWeekday Int?
  exercises SessionExercise[]
  @@unique([ownerId, startKey])
  @@index([ownerId, localDate])
}

model Exercise {
  id            String   @id @default(cuid())
  ownerId       String?
  owner         User?    @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  scopeKey      String
  name          String
  nameKey       String
  aliases       String[] @default([])
  searchText    String
  equipment     String
  category      String
  execution     String
  measurement   String
  benchAngle    String   @default("")
  notes         String   @default("")
  active        Boolean  @default(true)
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  routineItems  RoutineItem[]
  sessionItems  SessionExercise[]

  @@unique([scopeKey, nameKey])
  @@index([ownerId, active])
}

model Routine {
  id        String @id @default(cuid())
  ownerId   String
  owner     User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  name      String
  version   Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  versions  RoutineVersion[]
  @@index([ownerId, updatedAt])
}
model RoutineVersion {
  id        String @id @default(cuid())
  routineId String
  routine   Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  number    Int
  name      String
  createdAt DateTime @default(now())
  days      RoutineDay[]
  sessions  WorkoutSession[]
  @@unique([routineId, number])
}

model SessionExercise {
  id String @id @default(cuid())
  sessionId String
  session WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  position Int
  exerciseName String
  equipment String
  execution String
  measurement String
  goalSets Int?
  goalMinReps Int?
  goalMaxReps Int?
  goalRir Int?
  benchAngle String
  notes String
  sets WorkoutSet[]
  @@unique([sessionId, position])
}
model RoutineDay {
  id        String @id @default(cuid())
  versionId String
  version   RoutineVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  weekday   Int
  rest      Boolean
  items     RoutineItem[]
  @@unique([versionId, weekday])
}
model RoutineItem {
  id           String @id @default(cuid())
  dayId        String
  day          RoutineDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  position     Int
  exerciseId   String
  exercise     Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  exerciseName String
  equipment    String
  sets         Int
  minReps      Int
  maxReps      Int
  rir          Int?
  benchAngle   String
  notes        String
  @@unique([dayId, position])
}

model WorkoutSet {
  id String @id @default(cuid())
  sessionExerciseId String
  exercise SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)
  position Int
  weightKg Float?
  dumbbellCount Int?
  reps Int?
  completed Boolean @default(false)
  side String @default("unspecified")
  kind String @default("working")
  actualRir Int?
  @@unique([sessionExerciseId, position])
}
